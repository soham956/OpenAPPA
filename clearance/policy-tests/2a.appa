# 2a: after a Legal read, sending the Legal files to both recipients is denied, because
# counsel@outside-firm.test is not a reader of Legal content.
mcp/clearance/drive_read {
  fileId: "01-mutual-nda-kestrel-orbit"
  folder: "legal"
}
expect allow

mcp/clearance/send {
  to: ["legal@hashirai-poc.test", "counsel@outside-firm.test"]
  subject: "Legal documents for review"
  attachments: ["01-mutual-nda-kestrel-orbit.txt", "02-master-services-agreement.txt", "03-cease-and-desist-letter.txt", "04-board-resolution-oct.txt"]
}
expect deny
