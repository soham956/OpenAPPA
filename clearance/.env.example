# Hashirai Clearance POC environment.
# Copy this file to the REPO ROOT, not into clearance/:
#   cp clearance/.env.example .env      (run from the repo root)
# src/config.ts loads ../.env relative to clearance/. Real environment
# variables override values in .env. Never commit .env or anything in secrets/.

# TypeSafe (Jev) API key. Only needed for live classification or fixture:record.
TYPESAFE_API_KEY=

# Google Drive test folder ID (the root that holds Legal/, Accounting/, High Risk/).
GDRIVE_ROOT_FOLDER_ID=
# oauth (client JSON at secrets/gdrive-oauth-client.json, token cached at
# secrets/gdrive-token.json) or service-account (key at secrets/gdrive-sa.json).
GDRIVE_AUTH=oauth

# replay = use fixtures/classifications.json, call Jev live only on a miss.
CLASSIFIER_MODE=replay
# Jev answers below this confidence go to High Risk.
CONFIDENCE_THRESHOLD=0.70

# Path to the appa CLI; empty means `appa` on PATH.
APPA_BIN=
# Loopback port for the appa runtime sidecar.
APPA_PORT=8790
# Drive root poll interval in milliseconds.
POLL_INTERVAL_MS=10000

# CI only: set to 1 so live appa tests fail instead of skipping.
CLEARANCE_REQUIRE_APPA=
